# ==========================================
# Kallia - Variáveis de Ambiente (Coolify / Docker)
# ==========================================

# Integração PocketBase (Backend OpenSource de Autenticação e Coleções)
POCKETBASE_URL=http://localhost:8090
POCKETBASE_ADMIN_EMAIL=admin@kallia.local
POCKETBASE_ADMIN_PASSWORD=sua_senha_admin_pocketbase
POCKETBASE_ENCRYPTION_KEY=sua_chave_de_criptografia_pocketbase_aqui

# Integração Redis (Fila de Chamadas Concorrentes, Rate Limiting & Webhooks)
REDIS_URL=redis://localhost:6379

# Limites e Autenticação do Servidor VoIP
KALLIA_MAX_CALLS=8
KALLIA_JWT_SECRET=seu_jwt_secret_super_seguro_aqui
KALLIA_ENCRYPTION_KEY=sua_chave_mestre_de_criptografia_aes256_aqui

# Configurações de Mídia VoIP (WebRTC)
KALLIA_PUBLIC_IP=auto
KALLIA_UDP_PORT=50000

# Nível de log (debug|info|warn|error)
KALLIA_LOG_LEVEL=info

# CORS: origens permitidas separadas por vírgula (ex: https://app.seudominio.com,https://pb.seudominio.com)
KALLIA_CORS_ORIGINS=*

# Diretório de armazenamento persistente (SQLite Whatsmeow + Gravações)
KALLIA_STORAGE_DIR=./storage

# PostgreSQL + pgvector (Módulo Omnichannel: Conversas, Contatos, Tags, CRM, RAG)
KALLIA_PG_URL=postgres://kallia:kallia_secure_2026@localhost:5432/kallia?sslmode=disable
POSTGRES_USER=kallia
POSTGRES_PASSWORD=kallia_secure_2026
POSTGRES_DB=kallia
